{
    "compilerOptions": {
        "target": "es6",
        "module": "commonjs",
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@client/*": ["src/client/*"],
            "@server/*": ["src/server/*"],
            "@config/*": ["config/*"]
        }
    },
    "include": ["src/**/*", "scripts/**/*", "config/**/*", "webpack.config.js"],
    "exclude": ["node_modules", "dist", "tmp"]
}
